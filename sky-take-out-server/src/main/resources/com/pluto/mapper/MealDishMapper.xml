<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.pluto.mapper.MealDishMapper">
      <insert id="addBatch">
            insert into meal_dish (meal_id, dish_id, quantity)
            values 
            <foreach collection="mealDishes" item="mealDish" separator=",">
                  (#{mealDish.mealId}, #{mealDish.dishId}, #{mealDish.quantity})
            </foreach>
      </insert>
</mapper>