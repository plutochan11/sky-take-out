<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.pluto.mapper.DishClassificationDishMapper">

      <insert id="addDishesToClassification">
            insert into dish_classification_dish (dish_classification_id, dish_id)
            values
            <foreach collection="dishIds" item="dishId" separator=",">
                  (#{classificationId}, #{dishId})
            </foreach>
      </insert>
</mapper>